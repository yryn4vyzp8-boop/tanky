{
  "name": "tanky",
  "private": true,
  "version": "0.1.0",
  "description": "TANKY — Swiss mobile fueling, payment & mobility platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @tanky/api",
    "dev:mobile": "npm run dev -w @tanky/mobile",
    "build:domain": "npm run build -w @tanky/domain",
    "test:domain": "npm run test -w @tanky/domain",
    "test:api": "npm run test -w @tanky/api"
  },
  "engines": {
    "node": ">=20"
  }
}
